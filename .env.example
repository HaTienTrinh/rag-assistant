DATABASE_URL=mysql+pymysql://user:pass@localhost:3307/rag_app?charset=utf8mb4
SECRET_KEY=change_me_to_a_random_secure_secret_key
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_REUSE_GRACE_SECONDS=10
COOKIE_SECURE=false

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHUNK_WORDS=60
CHUNK_OVERLAP=15
TOP_K=8
MIN_SCORE=0.25
DEBUG_RAG=false

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

HISTORY_MESSAGES=8
DAILY_QUESTION_LIMIT=50
DISPLAY_UTC_OFFSET_MINUTES=420

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password
DEMO_EMAIL=user@example.com
DEMO_PASSWORD=change_me_user_password
